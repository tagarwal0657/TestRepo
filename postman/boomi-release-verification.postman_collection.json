    {
      "name": "2. Discover sub-accounts",
      "description": "`POST Account/query` lists accounts created by the parent. The mock pages at 2 results and returns `queryToken`; `queryMore` posts that token as **raw text/plain**, not JSON.",
      "item": [
        {
          "name": "POST Account/query",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"QueryFilter\": {\n    \"expression\": {\n      \"property\": \"status\",\n      \"operator\": \"NOT_EQUALS\",\n      \"argument\": [\"deleted\"]\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/rest/v1/{{masterAccountId}}/Account/query",
            "description": "Filter out deleted accounts. Saves `queryToken` when present so the next request can page."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test(\"QueryResult shape\", function () {",
                  "    pm.expect(body).to.have.property(\"numberOfResults\");",
                  "    pm.expect(body).to.have.property(\"result\");",
                  "});",
                  "if (body.queryToken) {",
                  "    pm.collectionVariables.set(\"queryToken\", body.queryToken);",
                  "    console.log(\"saved queryToken for queryMore\");",
                  "} else {",
                  "    pm.collectionVariables.unset(\"queryToken\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Account/queryMore",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "text/plain",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{queryToken}}",
              "options": {
                "raw": {
                  "language": "text"
                }
              }
            },
            "url": "{{baseUrl}}/api/rest/v1/{{masterAccountId}}/Account/queryMore",
            "description": "Body is the queryToken string from the previous page. Content-Type must be `text/plain`. Tokens are single-use."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('queryToken')) {",
                  "    console.log(\"No queryToken from the previous query \u2014 skip or expect an empty page.\");",
                  "}",
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test(\"QueryResult shape\", function () {",
                  "    pm.expect(body).to.have.property(\"numberOfResults\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Sub-account deployments (Platform API)",
      "description": "Platform API account override: the sub-account ID replaces the account segment in the path. Each request is `POST DeployedPackage/query` filtered by `componentId` and `active=true`. Compare `packageVersion` to the parent's `releasedVersion`.",
      "item": [
        {
          "name": "DeployedPackage/query for {{subAccountId}}",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"QueryFilter\": {\n    \"expression\": {\n      \"operator\": \"and\",\n      \"nestedExpression\": [\n        {\n          \"property\": \"componentId\",\n          \"operator\": \"EQUALS\",\n          \"argument\": [\"{{componentId}}\"]\n        },\n        {\n          \"property\": \"active\",\n          \"operator\": \"EQUALS\",\n          \"argument\": [\"true\"]\n        }\n      ]\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/rest/v1/{{subAccountId}}/DeployedPackage/query",
            "description": "Generic Platform API override. Change `subAccountId` in the environment to point at a live tenant. The named mock requests below bake the account ID into the URL so a collection run hits every fixture."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test(\"QueryResult shape\", function () {",
                  "    pm.expect(body).to.have.property(\"numberOfResults\");",
                  "});",
                  "const results = Array.isArray(body.result) ? body.result : (body.result ? [body.result] : []);",
                  "results.forEach(function (row, index) {",
                  "    console.log((index + 1) + \". packageVersion=\" + row.packageVersion",
                  "        + \" env=\" + row.environmentId",
                  "        + \" active=\" + row.active",
                  "        + \" deployedDate=\" + row.deployedDate);",
                  "});"
                ]
              }
            }
          ]
        },
