  "item": [
    {
      "name": "1. Parent - what was released",
      "description": "GET ReleaseIntegrationPackStatus on the master account. HTTP 202 means IN_PROGRESS or SCHEDULED; HTTP 200 means released details (componentId + releasedVersion) are available. The mock returns 202 twice then 200, so this folder sends the GET three times in a single collection run.",
      "item": [
        {
          "name": "GET ReleaseIntegrationPackStatus (poll 1)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/rest/v1/{{masterAccountId}}/ReleaseIntegrationPackStatus/{{requestId}}",
            "description": "First poll. Mock returns HTTP 202 / IN_PROGRESS. Tests still accept 200 so a live tenant that is already done does not fail."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200 or 202 (Boomi still uses 202 while IN_PROGRESS/SCHEDULED)\", function () {",
                  "    pm.expect([200, 202]).to.include(pm.response.code);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"payload identifies the release\", function () {",
                  "    pm.expect(body).to.have.property(\"releaseStatus\");",
                  "    pm.expect(body).to.have.property(\"requestId\");",
                  "});",
                  "if (pm.response.code === 200 && body.ReleasePackagedComponents) {",
                  "    let components = body.ReleasePackagedComponents.ReleasePackagedComponent;",
                  "    if (!Array.isArray(components)) {",
                  "        components = components ? [components] : [];",
                  "    }",
                  "    pm.test(\"released components include componentId + releasedVersion\", function () {",
                  "        pm.expect(components.length).to.be.above(0);",
                  "        pm.expect(components[0]).to.have.property(\"componentId\");",
                  "        pm.expect(components[0]).to.have.property(\"releasedVersion\");",
                  "    });",
                  "    if (components[0]) {",
                  "        pm.collectionVariables.set(\"componentId\", components[0].componentId);",
                  "        pm.collectionVariables.set(\"releasedVersion\", components[0].releasedVersion || \"\");",
                  "    }",
                  "    if (components[1]) {",
                  "        pm.collectionVariables.set(\"componentId2\", components[1].componentId);",
                  "    }",
                  "    if (body.integrationPackId) {",
                  "        pm.collectionVariables.set(\"integrationPackId\", body.integrationPackId);",
                  "    }",
                  "}",
                  "console.log(\"releaseStatus=\" + body.releaseStatus + \" HTTP \" + pm.response.code);"
                ]
              }
            }
          ]
        },
